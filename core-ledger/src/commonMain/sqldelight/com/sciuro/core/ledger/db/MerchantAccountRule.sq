CREATE TABLE merchant_account_rule (
    merchant_key TEXT NOT NULL,
    account_id TEXT NOT NULL,
    confirmation_count INTEGER NOT NULL DEFAULT 1,
    first_seen_at INTEGER NOT NULL,
    last_confirmed_at INTEGER NOT NULL,
    PRIMARY KEY (merchant_key, account_id)
);

upsertMerchantAccountRule:
INSERT OR REPLACE INTO merchant_account_rule(merchant_key, account_id, confirmation_count, first_seen_at, last_confirmed_at)
VALUES (?, ?, COALESCE((SELECT confirmation_count + 1 FROM merchant_account_rule WHERE merchant_key = ? AND account_id = ?), 1), ?, ?);

selectMerchantAccountRule:
SELECT * FROM merchant_account_rule WHERE merchant_key = ?;

selectTopAccountForMerchant:
SELECT * FROM merchant_account_rule WHERE merchant_key = ? ORDER BY confirmation_count DESC LIMIT 1;

selectAllMerchantAccountRules:
SELECT * FROM merchant_account_rule ORDER BY confirmation_count DESC;

deleteMerchantAccountRule:
DELETE FROM merchant_account_rule WHERE merchant_key = ? AND account_id = ?;

deleteMerchantAccountRuleByAccount:
DELETE FROM merchant_account_rule WHERE account_id = ?;
