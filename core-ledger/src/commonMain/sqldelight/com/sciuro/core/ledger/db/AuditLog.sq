CREATE TABLE audit_log_entity (
    id TEXT NOT NULL PRIMARY KEY,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    action TEXT NOT NULL,
    beforeState TEXT,
    afterState TEXT,
    source TEXT NOT NULL,
    confidence REAL,
    timestamp INTEGER NOT NULL
);

insertLog:
INSERT INTO audit_log_entity(id, entityType, entityId, action, beforeState, afterState, source, confidence, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getLogsForEntity:
SELECT * FROM audit_log_entity
WHERE entityId = ? AND entityType = ?
ORDER BY timestamp DESC;

getAllLogs:
SELECT * FROM audit_log_entity
ORDER BY timestamp DESC;

auditIntegrityCheck:
SELECT COUNT(*) FROM transaction_record
WHERE id NOT IN (SELECT entityId FROM audit_log_entity WHERE entityType = 'TRANSACTION');
