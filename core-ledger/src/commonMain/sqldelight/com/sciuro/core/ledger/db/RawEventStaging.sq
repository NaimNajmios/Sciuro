CREATE TABLE raw_event_staging (
    id TEXT NOT NULL PRIMARY KEY,
    source_type TEXT NOT NULL,
    source_package_or_address TEXT NOT NULL,
    title TEXT NOT NULL,
    text TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    captured_at INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    attempt_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    processed_at INTEGER,
    is_read INTEGER NOT NULL DEFAULT 0,
    activity_status TEXT,
    financial_signal INTEGER NOT NULL DEFAULT 0,
    activity_reason TEXT,
    user_alerted_at INTEGER
);

CREATE INDEX idx_raw_event_status ON raw_event_staging(status);
CREATE INDEX idx_raw_event_status_captured ON raw_event_staging(status, captured_at);

insertRawEvent:
INSERT INTO raw_event_staging(id, source_type, source_package_or_address, title, text, timestamp, captured_at, status, financial_signal)
VALUES (?, ?, ?, ?, ?, ?, ?, 'PENDING', ?);

markProcessing:
UPDATE raw_event_staging SET status = 'PROCESSING', attempt_count = attempt_count + 1, last_error = ? WHERE id = ? AND status = 'PENDING';

markProcessed:
UPDATE raw_event_staging SET status = 'PROCESSED', processed_at = ? WHERE id = ?;

markDeadLetter:
UPDATE raw_event_staging SET status = 'DEAD_LETTER', last_error = ? WHERE id = ?;

selectPendingEvents:
SELECT * FROM raw_event_staging WHERE status = 'PENDING' ORDER BY captured_at ASC;

selectDeadLetterEvents:
SELECT * FROM raw_event_staging WHERE status = 'DEAD_LETTER' ORDER BY captured_at DESC;

selectLastCapturedAt:
SELECT MAX(captured_at) AS last_captured_at FROM raw_event_staging;

countPending:
SELECT COUNT(*) FROM raw_event_staging WHERE status = 'PENDING';

selectRawEventById:
SELECT * FROM raw_event_staging WHERE id = ?;

countDeadLetter:
SELECT COUNT(*) FROM raw_event_staging WHERE status = 'DEAD_LETTER';

selectMatchRateByPackage:
SELECT
    source_package_or_address AS package_name,
    COUNT(*) AS total,
    SUM(CASE WHEN status = 'PROCESSED' THEN 1 ELSE 0 END) AS processed,
    SUM(CASE WHEN status = 'DEAD_LETTER' THEN 1 ELSE 0 END) AS dead_letter,
    MAX(captured_at) AS last_captured_at
FROM raw_event_staging
WHERE captured_at >= ?
GROUP BY source_package_or_address
ORDER BY total DESC;

selectStrandedEvents:
SELECT * FROM raw_event_staging
WHERE status = 'PENDING'
   OR (status = 'PROCESSING' AND captured_at < ?)
ORDER BY captured_at ASC;

selectStrandedEventsCount:
SELECT COUNT(*) FROM raw_event_staging
WHERE status = 'PENDING'
   OR (status = 'PROCESSING' AND captured_at < ?);

requeueRawEvent:
UPDATE raw_event_staging
SET status = 'PENDING', attempt_count = 0, last_error = NULL
WHERE id = ?;

updateRawEventPayload:
UPDATE raw_event_staging
SET title = ?, text = ?
WHERE id = ?;

selectMatchRateByPackageRecent:
SELECT
    source_package_or_address AS package_name,
    COUNT(*) AS total,
    SUM(CASE WHEN status = 'PROCESSED' THEN 1 ELSE 0 END) AS processed,
    SUM(CASE WHEN status = 'DEAD_LETTER' THEN 1 ELSE 0 END) AS dead_letter,
    MAX(captured_at) AS last_captured_at
FROM raw_event_staging
WHERE captured_at >= ? AND captured_at < ?
GROUP BY source_package_or_address
ORDER BY total DESC;

selectDeadLetterEventsPaginated:
SELECT * FROM raw_event_staging
WHERE status = 'DEAD_LETTER'
  AND (:showRead = 1 OR is_read = 0)
ORDER BY captured_at DESC
LIMIT :limit OFFSET :offset;

countDeadLetterFiltered:
SELECT COUNT(*) FROM raw_event_staging
WHERE status = 'DEAD_LETTER'
  AND (:showRead = 1 OR is_read = 0);

markRead:
UPDATE raw_event_staging SET is_read = 1 WHERE id = ?;

markAllDeadLetterRead:
UPDATE raw_event_staging SET is_read = 1 WHERE status = 'DEAD_LETTER';

markActivityStatus:
UPDATE raw_event_staging
SET activity_status = ?, activity_reason = ?
WHERE id = ?;

markUserAlerted:
UPDATE raw_event_staging
SET user_alerted_at = ?
WHERE id = ?;

selectRecentActivity:
SELECT * FROM raw_event_staging
WHERE activity_status IN ('PARSED', 'NEEDS_REVIEW', 'DROPPED')
ORDER BY captured_at DESC
LIMIT ?;

selectUnacknowledgedParseFailures:
SELECT * FROM raw_event_staging
WHERE activity_status = 'DROPPED' AND user_alerted_at IS NULL
ORDER BY captured_at DESC
LIMIT ?;
