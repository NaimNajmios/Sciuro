CREATE TABLE domain_event_log (
    event_id TEXT NOT NULL PRIMARY KEY,
    sequence INTEGER NOT NULL UNIQUE,
    event_type TEXT NOT NULL,
    schema_version INTEGER NOT NULL,
    payload_json TEXT NOT NULL,
    occurred_at INTEGER NOT NULL,
    producer TEXT,
    critical INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX domain_event_log_sequence ON domain_event_log(sequence);
CREATE INDEX domain_event_log_occurred_at ON domain_event_log(occurred_at);
CREATE INDEX domain_event_log_event_type ON domain_event_log(event_type);
CREATE INDEX domain_event_log_critical ON domain_event_log(critical);

CREATE TABLE domain_event_delivery (
    event_id TEXT NOT NULL,
    subscriber_id TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    attempt_count INTEGER NOT NULL DEFAULT 0,
    available_at INTEGER NOT NULL DEFAULT 0,
    lease_until INTEGER,
    last_error TEXT,
    acknowledged_at INTEGER,
    PRIMARY KEY (event_id, subscriber_id)
);

CREATE INDEX domain_event_delivery_status ON domain_event_delivery(status);
CREATE INDEX domain_event_delivery_subscriber ON domain_event_delivery(subscriber_id, status);
CREATE INDEX domain_event_delivery_lease ON domain_event_delivery(lease_until);
